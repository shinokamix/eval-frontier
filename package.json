{
  "name": "harness-pareto",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vp build",
    "check:architecture": "node scripts/check-architecture.mjs",
    "data:build": "node scripts/data/cli.ts build",
    "data:capture": "node scripts/data/cli.ts capture",
    "data:extract": "node scripts/data/cli.ts extract",
    "data:test": "node --test scripts/data/**/*.test.ts",
    "data:verify": "node scripts/data/cli.ts verify",
    "dev": "vp dev",
    "lint": "vp lint",
    "prepare": "vp config --hooks --no-agent",
    "preview": "vp preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource/commit-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@tanstack/react-router": "^1.170.35",
    "@tanstack/react-router-devtools": "^1.167.1",
    "cn": "^0.2.6",
    "csv-parse": "^7.0.2",
    "lenis": "^1.3.26",
    "lucide-react": "^1.45.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.37",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    }
  }
}
